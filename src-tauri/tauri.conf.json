{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "GeoPOSTik",
  "version": "0.1.2",
  "identifier": "id.geopostik.app",
  "build": {
    "frontendDist": "../dist/geopostik/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GeoPOSTik",
        "width": 1366,
        "height": 768,
        "minWidth": 1024,
        "minHeight": 700,
        "maximized": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" }
    }
  }
}
